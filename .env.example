# Copy this file to .env before the first deployment.
# Replace every CHANGE_ME value. Do not commit the real .env file.
MYSQL_DATABASE=agp
MYSQL_USER=agp
MYSQL_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_RANDOM_ROOT_PASSWORD

# At least 32 random characters. Changing it signs every user out.
AGP_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

BOOTSTRAP_SUPERADMIN_USERNAME=admin
BOOTSTRAP_SUPERADMIN_PASSWORD=CHANGE_ME_RANDOM_ADMIN_PASSWORD
BOOTSTRAP_SUPERADMIN_DISPLAY_NAME=超级管理员

AGP_WEB_PORT=2973
AGP_MYSQL_PORT=3307
